# ========================================
# 佰利涂装应用学院 - 环境变量模板
# 复制此文件为 .env.local 并填入实际值
# ========================================

# 网站基础 URL（用于 SEO / sitemap / OG 标签）
NEXT_PUBLIC_SITE_URL=https://www.baili-academy.com

# Google Analytics 4 追踪 ID（留空则不加载 GA）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 联系表单接收邮箱
CONTACT_EMAIL=info@baili-academy.com

# Resend 邮件服务 API Key（https://resend.com）
# 留空则跳过邮件发送，仅返回成功响应
RESEND_API_KEY=
