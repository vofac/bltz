# ========================================
# GEO Intelligence Platform — 环境变量模板
# 复制为 .env 并按需修改
# ========================================

# ---- 数据库 ----
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
DATABASE_URL=postgresql+psycopg2://geo:geo@postgres:5432/geo

# ---- 缓存 / 任务队列 ----
REDIS_URL=redis://redis:6379/0

# ---- 向量数据库 ----
VECTOR_DB_URL=http://qdrant:6333

# ---- 鉴权 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI Provider ----
# mock：Phase 1 使用可切换的模拟数据打通全流程
# live：接入真实厂商 API（需要下方 Key）
AI_PROVIDER_MODE=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# ---- 前端 ----
NEXT_PUBLIC_API_URL=http://localhost:8000
