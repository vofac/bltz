# ========================================
# GEO Intelligence Platform — 环境变量模板
# 复制为 .env 并按需修改
# ========================================

# ---- 数据库 ----
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
DATABASE_URL=postgresql+psycopg2://geo:geo@postgres:5432/geo

# ---- 缓存 / 任务队列 ----
REDIS_URL=redis://redis:6379/0

# ---- 向量数据库 ----
VECTOR_DB_URL=http://qdrant:6333

# ---- 鉴权 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI Provider ----
# mock：使用可复现的模拟数据打通关键词监测/内容生成全流程，无需任何 Key
# live：接入真实厂商 API（需要下方 Key）。Google AI Overview 没有官方公开 API，
#       live 模式下会自动回退到 mock。
AI_PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# 以上模型 ID 会随厂商版本更新，部署前请对照官方文档核实当前可用值

# ---- 向量化 Embedding Provider ----
# mock：基于文本哈希生成确定性向量，可打通存储/检索链路，但不具备真实语义相似度
# live：接入真实 embedding 模型（Phase 2 后续实现）
EMBEDDING_PROVIDER_MODE=mock

# ---- 企业知识库文件存储 ----
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20

# ---- 前端 ----
NEXT_PUBLIC_API_URL=http://localhost:8000
